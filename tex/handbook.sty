% The style of The Handbook of Algorithms (spec handbook 05).
% XeLaTeX (tectonic). Open fonts from the TeX Live bundle.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{handbook}[2026/11/09 The Handbook of Algorithms]

% ------------------------------------------------------------------ page
\RequirePackage[paperwidth=7in,paperheight=10in,inner=0.85in,outer=0.8in,
  top=0.9in,bottom=0.95in,headsep=0.3in,footskip=0.45in,marginparwidth=0.6in]{geometry}

% ------------------------------------------------------------------ fonts
\RequirePackage{amsmath,amssymb}
\RequirePackage{mathtools}
\RequirePackage{fontspec}
\RequirePackage[warnings-off={mathtools-colon,mathtools-overbracket}]{unicode-math}
\RequirePackage{centernot}   % \not over a relation with no negated Unicode form (\leadsto) crashes XeTeX
\defaultfontfeatures{Ligatures=TeX}
\setmainfont{LibertinusSerif}[Extension=.otf,UprightFont=*-Regular,ItalicFont=*-Italic,
  BoldFont=*-Bold,BoldItalicFont=*-BoldItalic,Scale=1.0,Numbers=Proportional]
\setsansfont{LibertinusSans}[Extension=.otf,UprightFont=*-Regular,ItalicFont=*-Italic,
  BoldFont=*-Bold,BoldItalicFont=*-Bold]
\setmonofont{DejaVuSansMono}[Extension=.ttf,UprightFont=*,BoldFont=*-Bold,Scale=0.82]
\setmathfont{LibertinusMath-Regular.otf}
\newfontfamily\hbfbA{LibertinusMath-Regular.otf}
\newfontfamily\hbfbB{DejaVuSansMono.ttf}[Scale=0.82]
\newfontfamily\hbfbC{STIXTwoMath-Regular.otf}
\newfontfamily\hbfbD{FreeSerif.otf}
\newfontfamily\hbfbE{FandolSong-Regular.otf}
\newfontfamily\hbfbF{LibertinusSerif-Regular.otf}
\newcommand\hbfb[2]{\texorpdfstring{{\csname hbfb#1\endcsname #2}}{#2}}
\newfontfamily\hbcondensed{LibertinusSans}[Extension=.otf,UprightFont=*-Regular,BoldFont=*-Bold]

% ------------------------------------------------------------------ colour
\RequirePackage{xcolor}
\definecolor{hbink}{HTML}{1F2328}
\definecolor{hbmuted}{HTML}{6B7280}
\definecolor{hbrule}{HTML}{D0D5DD}
\providecolor{hbaccent}{HTML}{2B59C3}   % the hue of the volume, set by the volume file
\colorlet{hbaccentdark}{hbaccent!75!black}
\colorlet{hbtint}{hbaccent!6!white}
\colorlet{hbtintgray}{black!3!white}
\color{hbink}

% ------------------------------------------------------------------ packages
\RequirePackage{graphicx}
\RequirePackage{booktabs,longtable,array,calc,multicol,etoolbox}
\RequirePackage{needspace}
\RequirePackage[protrusion=true,expansion=false]{microtype}
\RequirePackage{fvextra}
\fvset{breaklines=true,breakanywhere=true,breaksymbolleft={},breakanywheresymbolpre={}}
\RequirePackage[most]{tcolorbox}
\RequirePackage{enumitem}
\setlist{itemsep=1pt,topsep=3pt,parsep=1pt}
\RequirePackage{fancyhdr}
\RequirePackage{xurl}
\RequirePackage{bookmark}
\RequirePackage{hyperref}
\hypersetup{colorlinks=true,linkcolor=hbaccentdark,urlcolor=hbaccentdark,citecolor=hbaccentdark,
  bookmarksnumbered=true,bookmarksopen=true,bookmarksopenlevel=1,pdfdisplaydoctitle=true,unicode=true}
\urlstyle{same}

% pandoc needs these
\newcounter{none}
\providecommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}
\providecommand{\pandocbounded}[1]{#1}
\newcommand{\passthrough}[1]{#1}
\setlength{\emergencystretch}{3em}
\tolerance=1500
\hbadness=3000
\vbadness=10000
\hfuzz=2pt
\setlength{\parindent}{1.2em}
\setlength{\parskip}{0pt plus 1pt}
\frenchspacing
% the paragraph after a box, a list of exercises or a display starts flush left
\newcommand\hbnoindentnext{\everypar{{\setbox0\lastbox}\everypar{}}}
\widowpenalty=3000
\clubpenalty=3000
\raggedbottom

% KaTeX names that LaTeX lacks (spec handbook 01.5)
\providecommand{\llbracket}{\lBrack}
\providecommand{\rrbracket}{\rBrack}
