\renewcommand{\boldsymbol}[1]{\symbf{#1}}
\providecommand{\Set}[1]{\{#1\}}
\providecommand{\argmin}{\operatorname*{arg\,min}}
\providecommand{\argmax}{\operatorname*{arg\,max}}

% tables: smaller type, ragged cells
\AtBeginEnvironment{longtable}{\small\sffamily}
\setlength{\LTpre}{6pt}
\setlength{\LTpost}{6pt}
\renewcommand{\arraystretch}{1.15}

% ------------------------------------------------------------------ headings
\setcounter{secnumdepth}{-2}
\setcounter{tocdepth}{2}
\newcommand\hbvolnum{0}
\newcommand\hbvolname{}
\newcommand\hbchapnum{0}
\renewcommand\thefigure{\hbchapnum.\arabic{figure}}   % Figure 4.1.2: the second figure of chapter 4.1

\newcommand\hbchapter[3]{%
  \cleardoublepage
  \thispagestyle{hbplain}%
  \phantomsection\label{#3}%
  \gdef\hbchapnum{#1}\setcounter{figure}{0}%
  \addcontentsline{toc}{chapter}{\protect\numberline{#1}#2}%
  \markboth{#1\quad #2}{#1\quad #2}%
  \vspace*{0.6in}%
  {\noindent\sffamily\bfseries\color{hbaccent}\fontsize{54}{54}\selectfont #1\par}
  \vspace{10pt}%
  {\noindent\color{hbaccent}\rule{\textwidth}{1.2pt}\par}
  \vspace{12pt}%
  {\noindent\raggedright\sffamily\bfseries\fontsize{26}{30}\selectfont #2\par}
  \vspace{28pt}%
  \@afterheading}

\newcommand\hbintro[2]{% an unnumbered chapter: the introduction, the appendices
  \cleardoublepage
  \thispagestyle{hbplain}%
  \phantomsection\label{#2}%
  \xdef\hbchapnum{\hbvolnum.0}\setcounter{figure}{0}%
  \addcontentsline{toc}{chapter}{#1}%
  \markboth{#1}{#1}%
  \vspace*{0.6in}%
  {\noindent\color{hbaccent}\rule{\textwidth}{1.2pt}\par}
  \vspace{12pt}%
  {\noindent\raggedright\sffamily\bfseries\fontsize{26}{30}\selectfont #1\par}
  \vspace{28pt}%
  \@afterheading}

\newcommand\hbgroup[1]{%
  \par\addvspace{20pt}\needspace{16\baselineskip}%
  \phantomsection\addcontentsline{toc}{section}{#1}%
  {\noindent\sffamily\bfseries\large\color{hbaccentdark}#1\par}%
  \nobreak\vspace{2pt}{\noindent\color{hbrule}\rule{\textwidth}{0.5pt}\par}\nobreak
  \vspace{6pt}\@afterheading}

% \hbentry{number}{name}{label}{kind}{level}
\newcommand\hbentry[5]{%
  \par\addvspace{22pt}\needspace{9\baselineskip}%
  \phantomsection\label{#3}%
  \addcontentsline{toc}{subsection}{\protect\numberline{#1}#2}%
  \markright{#1\quad #2}%
  {\noindent\parbox[b]{\textwidth}{\raggedright
    {\sffamily\bfseries\color{hbaccent}\large #1}\hspace{0.6em}%
    {\sffamily\bfseries\Large #2}\hfill
    {\sffamily\scriptsize\color{hbmuted}\addfontfeatures{LetterSpace=8}\MakeUppercase{#4}\enspace·\enspace\MakeUppercase{#5}}}\par}%
  \nobreak\vspace{3pt}{\noindent\color{hbaccent}\rule{\textwidth}{0.8pt}\par}\nobreak
  \vspace{4pt}\@afterheading}

% the sections inside an entry (pandoc level 4 and 5)
\makeatletter
\renewcommand\subsubsection{\@startsection{subsubsection}{3}{\z@}%
  {-12pt plus -3pt minus -1pt}{4pt}{\sffamily\bfseries\normalsize\color{hbink}}}
\renewcommand\paragraph{\@startsection{paragraph}{4}{\z@}%
  {8pt plus 2pt minus 1pt}{-0.6em}{\sffamily\bfseries\small\color{hbink}}}
\renewcommand\subparagraph{\@startsection{subparagraph}{5}{\z@}%
  {6pt plus 2pt}{-0.5em}{\sffamily\itshape\small}}
\makeatother

% ------------------------------------------------------------------ the parts of an entry
\newenvironment{hblead}{\par\noindent\begin{minipage}{\textwidth}\itshape\color{hbink!85}}{\end{minipage}\par\vspace{6pt}}

\newtcolorbox{hbfactsbox}{enhanced,breakable,colback=hbtint,colframe=hbtint,boxrule=0pt,arc=1pt,
  left=8pt,right=8pt,top=5pt,bottom=5pt,borderline west={2pt}{0pt}{hbaccent},
  before skip=4pt,after skip=10pt,fontupper=\small}
\newenvironment{hbfacts}{\begin{hbfactsbox}\setlength{\parindent}{0pt}\setlength{\parskip}{1.5pt}%
  \everypar{\hangindent=6.2em\hangafter=1\relax}\raggedright}{\end{hbfactsbox}\aftergroup\hbnoindentnext}
\newcommand\hbfk[1]{\makebox[6.2em][l]{\sffamily\bfseries\footnotesize\color{hbaccentdark}#1}}

\makeatletter
\newtcolorbox{hbproofbox}{enhanced,breakable,colback=white,colframe=white,boxrule=0pt,arc=0pt,
  left=9pt,right=0pt,top=2pt,bottom=2pt,borderline west={0.8pt}{0pt}{hbaccent!45},before skip=8pt,after skip=10pt}
\newenvironment{hbproof}{\begin{hbproofbox}\setlength{\parindent}{1.2em}}{\end{hbproofbox}\aftergroup\hbnoindentnext}
\newcommand\hbprooftitle[1]{\noindent{\sffamily\bfseries\small\color{hbaccentdark}#1}\par\nobreak\vspace{1pt}\@afterheading}
\makeatother
\newcommand\hbref[1]{\,{\sffamily\scriptsize\color{hbmuted}#1}}

\newenvironment{hbseealso}{\par\vspace{6pt}\small\setlength{\parindent}{0pt}\raggedright
  \everypar{\everypar{}{\sffamily\bfseries\color{hbaccentdark}See also\enspace}}}{\par\aftergroup\hbnoindentnext}

\newenvironment{hbexercise}{\par\addvspace{5pt plus 1pt}\setlength{\parindent}{0pt}\setlength{\parskip}{3pt}}{\par\aftergroup\hbnoindentnext}
\newenvironment{hbrefs}{\par\raggedright\setlength{\parskip}{1pt}}{\par}
\newenvironment{hbhints}{\par\setlength{\parindent}{0pt}\setlength{\parskip}{5pt plus 1pt}}{\par}
\newenvironment{hbgroupintro}{\par\itshape}{\par\vspace{4pt}}
\newenvironment{hbroadmap}{\par\vspace{6pt}}{\par}
\newenvironment{hbfurther}{\par\small\raggedright}{\par}

% ------------------------------------------------------------------ pseudocode
\newtcolorbox{hbpseudobox}{enhanced,breakable,colback=hbtintgray,colframe=hbtintgray,boxrule=0pt,arc=1pt,
  left=6pt,right=8pt,top=5pt,bottom=5pt,before skip=8pt,after skip=8pt}
\newlength\hbplabel
\setlength\hbplabel{2.1em}
\newlength\hbpind
\newenvironment{hbpseudo}{\begin{hbpseudobox}\setlength{\parindent}{0pt}\setlength{\parskip}{0pt}%
  \raggedright\small\linespread{1.05}\selectfont}{\end{hbpseudobox}\aftergroup\hbnoindentnext}
% \hbpl{label}{indent}{code}{comment}
\newcommand\hbpl[4]{%
  \setlength\hbpind{#2\dimexpr1.4em\relax}%
  \par\hangindent=\dimexpr\hbplabel+\hbpind+1.4em\relax\hangafter=1
  \makebox[\hbplabel][l]{\sffamily\scriptsize\color{hbmuted}#1}\hspace*{\hbpind}#3%
  \ifblank{#4}{}{\unskip\nobreak\hfil\penalty50\hskip1.2em\hbox{}\nobreak\hfil
    {\color{hbmuted}\footnotesize ▷ #4}\parfillskip=0pt}\par}
\newcommand\hbpgap{\par\vspace{0.6\baselineskip}}
\newcommand\hbkw[1]{\textbf{#1}}
\newcommand\hbproc[1]{{\scshape\MakeLowercase{#1}}}

% ------------------------------------------------------------------ code
\DefineVerbatimEnvironment{hbverbatim}{Verbatim}{fontsize=\small,commandchars=\\\{\}}
\newtcolorbox{hbcodebox}[1]{enhanced,breakable,colback=white,colframe=hbrule,boxrule=0.4pt,arc=1pt,
  left=6pt,right=6pt,top=3pt,bottom=3pt,before skip=6pt,after skip=8pt,
  title={\sffamily\scriptsize #1},coltitle=hbmuted,colbacktitle=hbtintgray,
  toptitle=1pt,bottomtitle=1pt}
\newenvironment{hbcode}[1]{\begin{hbcodebox}{#1}\small}{\end{hbcodebox}\aftergroup\hbnoindentnext}

% ------------------------------------------------------------------ running heads
\fancypagestyle{hbmain}{%
  \fancyhf{}%
  \fancyhead[LE]{\sffamily\footnotesize\leavevmode\textcolor{hbmuted}{\leftmark}}%
  \fancyhead[RO]{\sffamily\footnotesize\leavevmode\textcolor{hbmuted}{\rightmark}}%
  \fancyfoot[LE,RO]{\sffamily\footnotesize\thepage}%
  \fancyfoot[RE,LO]{\sffamily\footnotesize\leavevmode\textcolor{hbmuted}{\hbvolumeline}}%
  \renewcommand{\headrulewidth}{0pt}}
\fancypagestyle{hbplain}{\fancyhf{}\fancyfoot[LE,RO]{\sffamily\footnotesize\thepage}\renewcommand{\headrulewidth}{0pt}}
\newcommand\hbvolumeline{Volume \hbvolnum\enspace·\enspace\hbvolname}

% ------------------------------------------------------------------ contents
\makeatletter
\renewcommand\tableofcontents{%
  \hbintro{Contents}{contents}%
  \@starttoc{toc}}
\renewcommand*\l@chapter[2]{%
  \addpenalty{-\@highpenalty}\vskip 9pt plus 1pt
  {\noindent\sffamily\bfseries\normalsize\color{hbaccentdark}%
   \setlength\@tempdima{3em}\leftskip\z@\rightskip\@pnumwidth plus 1fil\parfillskip -\@pnumwidth
   \let\numberline\hb@tocnum #1\nobreak\hfill\nobreak\hb@pnum{#2}\par}\nobreak}
\def\hb@tocnum#1{\makebox[3em][l]{#1}}
\def\hb@pnum#1{\hb@to\@pnumwidth{\hss #1}}
\def\hb@to{\hbox to}
\renewcommand*\l@section[2]{%
  {\sffamily\small\leftskip3em\rightskip\@pnumwidth plus 1fil\parfillskip -\@pnumwidth
   \noindent\itshape #1\nobreak\leaders\hbox{$\m@th\mkern 6mu\cdot\mkern 6mu$}\hfill\nobreak\hb@pnum{\upshape #2}\par}}
\renewcommand*\l@subsection[2]{%
  {\small\leftskip3em\rightskip\@pnumwidth plus 1fil\parfillskip -\@pnumwidth
   \noindent\def\numberline##1{\makebox[3.6em][l]{\sffamily\footnotesize\color{hbmuted}##1}}#1\nobreak
   \leaders\hbox{$\m@th\mkern 6mu\cdot\mkern 6mu$}\hfill\nobreak\hb@pnum{#2}\par}}
\makeatother

