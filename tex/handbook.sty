\newenvironment{hbbib}{\par\small\setlength{\parindent}{0pt}\setlength{\parskip}{3pt}\raggedright
  \everypar{\hangindent=1.5em\hangafter=1\relax}}{\par}
\newenvironment{hbglossary}{\par\small\setlength{\parindent}{0pt}\setlength{\parskip}{3pt}\raggedright
  \everypar{\hangindent=1.2em}}{\par}
\newenvironment{hbtimeline}{\par\small\setlength{\parindent}{0pt}\setlength{\parskip}{3pt}\raggedright
  \everypar{\hangindent=1.2em}}{\par}
\newcommand\hbidx[2]{\par\hangindent=1.5em #1\enspace{\color{hbmuted}#2}}
